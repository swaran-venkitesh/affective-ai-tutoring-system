# Copy this file to local_secrets.env and fill in real values.
TUTOR_SMTP_HOST=smtp.gmail.com
TUTOR_SMTP_PORT=587
TUTOR_SMTP_USER=your-tutor-mailbox@gmail.com
TUTOR_SMTP_PASS=your-16-digit-app-password
TUTOR_SMTP_FROM=your-tutor-mailbox@gmail.com
TUTOR_SMTP_TLS=1
EMOTION_ENGINE_ENABLED=true
EMOTION_ENGINE_ALLOW_CLIENT_TOGGLE=false
EMOTION_MONITOR_UI_ENABLED=false
EMOTION_ENGINE_VALIDATION_LOGS=true
